# Copy to .env.deploy, edit if needed, then run: source .env.deploy
export LCA_DEPLOY_HOST=lca.mathplosion.com
export LCA_DEPLOY_USER=root
export LCA_DEPLOY_PORT=22
export LCA_DEPLOY_SSH_KEY="$HOME/.ssh/id_ed25519"

# Advanced overrides normally do not need to change.
# LCA_DEPLOY_REPO_URL=https://github.com/prism-lca/life-cycle-assessment-mcp.git
# LCA_REMOTE_REPO_DIR=/opt/lca-benchmark
# LCA_DEPLOY_CONTAINER=lca-benchmark
# LCA_DEPLOY_VOLUME=lca_benchmark_brightway
# LCA_DEPLOY_IMAGE=lca-benchmark
# LCA_DEPLOY_PORT_BINDING=127.0.0.1:9000:9000
# LCA_DEPLOY_HEALTH_URL=http://127.0.0.1:9000/api/health
